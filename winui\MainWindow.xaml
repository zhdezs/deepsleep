<Window
    x:Class="TrollWrangler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:TrollWrangler">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <!-- 聊天气泡模板：AI 助手与 Agent 集群共用 -->
            <DataTemplate x:Key="ChatMessageTemplate" x:DataType="local:ChatItem">
                <StackPanel Margin="0,6">
                    <!-- 附带图片（生成图片工具） -->
                    <Image Source="{x:Bind Image}" MaxWidth="320" MaxHeight="320" Stretch="Uniform"
                           HorizontalAlignment="Center" Visibility="{x:Bind ImageVisibility}"
                           Margin="0,4,0,4"/>
                    <!-- 上传附件块 -->
                    <Border Visibility="{x:Bind AttachmentVisibility}" Background="{ThemeResource AttachBgBrush}"
                            CornerRadius="8" Padding="10,6" Margin="0,2,0,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind AttachmentName}" FontSize="13"
                                       Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="220" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind AttachmentSize}" FontSize="11"
                                       Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Bind TimeStr}" HorizontalAlignment="Center"
                               FontSize="11" Foreground="{ThemeResource MutedBrush}"
                               Visibility="{x:Bind ShowTimeVisibility}" Margin="0,4"/>
                    <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" HorizontalAlignment="Center"
                               FontSize="11" Foreground="{ThemeResource MutedBrush}"
                               TextWrapping="Wrap" MaxWidth="380"
                               Visibility="{x:Bind SysVisibility}" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind OtherVisibility, Mode=OneWay}">
                        <Border Style="{ThemeResource Avatar}" Background="{x:Bind AvatarBrush}">
                            <TextBlock Text="{x:Bind AvatarText}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel MaxWidth="{x:Bind BubbleMaxWidth, Mode=OneWay}" HorizontalAlignment="Left">
                            <Border Style="{ThemeResource OtherBubble}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="True" Width="16" Height="16"
                                                  Foreground="{ThemeResource AccentBrush}"
                                                  Visibility="{x:Bind ThinkingVisibility, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" TextWrapping="Wrap" FontSize="14"
                                               Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"
                                               Opacity="{x:Bind ThinkingOpacity, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{x:Bind Meta}" FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="4,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,3,0,0"
                                        Visibility="{x:Bind OperatorVisibility}">
                                <Button Content="复制" FontSize="11" Padding="8,3" CornerRadius="6" Click="CopyMessageClick"/>
                                <Button Content="删除" FontSize="11" Padding="8,3" CornerRadius="6" Click="DeleteMessageClick"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                Visibility="{x:Bind SelfVisibility, Mode=OneWay}">
                        <StackPanel MaxWidth="{x:Bind BubbleMaxWidth, Mode=OneWay}" HorizontalAlignment="Right">
                            <Border Style="{ThemeResource SelfBubble}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="True" Width="16" Height="16"
                                                  Foreground="{ThemeResource AccentBrush}"
                                                  Visibility="{x:Bind ThinkingVisibility, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" TextWrapping="Wrap" FontSize="14"
                                               Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"
                                               Opacity="{x:Bind ThinkingOpacity, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{x:Bind Meta}" FontSize="11" Foreground="{ThemeResource MutedBrush}"
                                       HorizontalAlignment="Right" Margin="0,2,4,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,3,4,0"
                                        Visibility="{x:Bind OperatorVisibility}">
                                <Button Content="复制" FontSize="11" Padding="8,3" CornerRadius="6" Click="CopyMessageClick"/>
                                <Button Content="删除" FontSize="11" Padding="8,3" CornerRadius="6" Click="DeleteMessageClick"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{ThemeResource AvatarSelf}">
                            <TextBlock Text="{x:Bind SelfAvatarText}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <!-- ══════════════ 左侧对话栏 ══════════════ -->
        <Grid Grid.Column="0" Background="{ThemeResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="16,16,16,12">
                <TextBlock Text="deepsleep" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                <TextBlock Text="AI 全能助手" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                <TextBox x:Name="ConvSearchBox" Margin="0,12,0,0" FontSize="13" MinHeight="36"
                         Style="{ThemeResource RoundTextBox}"
                         PlaceholderText="🔍 搜索对话…" TextChanged="ConvSearchBox_TextChanged"/>
            </StackPanel>

            <ListView x:Name="ConvList" Grid.Row="1" SelectionChanged="ConvList_SelectionChanged"
                      RightTapped="ConvList_RightTapped" DoubleTapped="ConvList_DoubleTapped"
                      Padding="8,0" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Conversation">
                        <StackPanel Padding="12,11" Margin="2,2">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Margin="0,3,0,0">
                                <Run Text="{x:Bind Items.Count, Mode=OneWay}"/>
                                <Run Text=" 条消息"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Padding="12" Spacing="8">
                <Button Content="＋ 新建对话" Click="NewConversationClick"
                        Background="{ThemeResource AccentBrush}" Foreground="White"
                        FontWeight="SemiBold" HorizontalAlignment="Stretch"
                        CornerRadius="10" Height="40"/>
                <ToggleButton x:Name="ThemeToggle" Content="🌙 深色" Click="ThemeToggleClick" HorizontalAlignment="Stretch"
                              CornerRadius="10"/>
                <Button x:Name="UpdateBtn" Content="⬆ 检查更新" Click="UpdateClick" HorizontalAlignment="Stretch"
                        CornerRadius="10" ToolTipService.ToolTip="检查并安装新版本（自动下载、静默升级、自动重启）"/>
                <TextBlock x:Name="UpdateStatusText" FontSize="11" Foreground="{ThemeResource MutedBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Button Content="⚙ 设置" Click="SettingsClick" HorizontalAlignment="Stretch" CornerRadius="10"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════ 右侧主区 ══════════════ -->
        <Grid Grid.Column="1">
            <Pivot x:Name="MainPivot" SelectionChanged="Pivot_SelectionChanged">

                <!-- AI 助手 -->
                <PivotItem Header="AI 助手">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="{ThemeResource PanelBrush}" Padding="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AI 助手" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                                <TextBlock x:Name="AgentStatusText" Text="后端：待配置" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="AgentBusyText" FontSize="12" Foreground="#07C160" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox x:Name="AgentModeBox" Width="130" SelectedIndex="1" SelectionChanged="AgentModeChanged"
                                          ToolTipService.ToolTip="运行模式：chat 聊天 / work 工作（命令需确认）/ boom 爆破（全自动）">
                                    <ComboBoxItem Content="chat · 聊天"/>
                                    <ComboBoxItem Content="work · 工作"/>
                                    <ComboBoxItem Content="boom · 爆破"/>
                                </ComboBox>
                                <ToggleButton x:Name="FastModeToggle" Style="{ThemeResource LineIconToggle}" Click="FastModeClick"
                                              ToolTipService.ToolTip="极速模式：短提示词 + 更小输出预算，响应更快（智能略降）">
                                    <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </ToggleButton>
                                <ToggleButton x:Name="AgentLocalToggle" Style="{ThemeResource LineIconToggle}" Click="AgentLocalToggleClick"
                                              ToolTipService.ToolTip="点亮=AI 助手与集群用本地自训练模型（零依赖、不花额度）">
                                    <FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </ToggleButton>
                                <Button Style="{ThemeResource LineIconButton}" Click="PromptTemplateMenuClick"
                                        ToolTipService.ToolTip="Prompt 模板库（快捷指令）">
                                    <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                                <Button Style="{ThemeResource LineIconButton}" Click="SkillsClick"
                                        ToolTipService.ToolTip="技能管理：从本地文件夹或 SKILL.md 链接安装技能">
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                                <Button x:Name="RegenerateBtn" Style="{ThemeResource LineIconButton}" Click="RegenerateClick"
                                        ToolTipService.ToolTip="删除上一条回复并重新生成">
                                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                                <Button Style="{ThemeResource LineIconButton}" Click="AgentClearClick"
                                        ToolTipService.ToolTip="清空当前 AI 助手会话">
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" x:Name="AgentScroll" VerticalScrollBarVisibility="Auto"
                                      Padding="14,12" VerticalAlignment="Top"
                                      ViewChanged="AgentScroll_ViewChanged">
                            <ItemsControl x:Name="AgentList" ItemTemplate="{ThemeResource ChatMessageTemplate}"/>
                        </ScrollViewer>
                        <Button x:Name="AgentScrollBottomBtn" Grid.Row="1"
                                Style="{ThemeResource LineIconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,12" Click="AgentScrollBottomClick"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="滚动至最底部">
                            <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        </Button>

                        <!-- 底部输入区：＋ / 🔍 / 发送按钮内嵌在输入框右下角 -->
                        <Grid Grid.Row="2" Background="{ThemeResource PanelBrush}" Padding="14,12">
                            <Grid>
                                <TextBox x:Name="AgentInput"
                                         Style="{ThemeResource RoundTextBox}"
                                         Padding="14,10,180,10"
                                         PlaceholderText="描述任务：如「搜索 ROG 全家桶价格」「生成 PPT」或「运行命令」…"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="140"
                                         FontSize="14" KeyDown="AgentInputKeyDown" KeyUp="AgentInputKeyUp"/>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,10,10">
                                    <Button x:Name="UploadBtn" Style="{ThemeResource LineIconButton}" Click="UploadClick"
                                            ToolTipService.ToolTip="上传文件给 AI（图片/文档/代码等）">
                                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                    </Button>
                                    <ToggleButton x:Name="SearchToggle" Style="{ThemeResource LineIconToggle}" Click="SearchToggleClick"
                                                  ToolTipService.ToolTip="联网搜索开关（开=AI 可联网查资料）">
                                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                    </ToggleButton>
                                    <Button x:Name="MemoryBtn" Style="{ThemeResource LineIconButton}" Click="MemoryClick"
                                            ToolTipService.ToolTip="长期记忆：查看/编辑跨会话记忆">
                                        <FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                    </Button>
                                    <Button x:Name="AgentSendBtn" Content="发送" MinWidth="64" Height="36" CornerRadius="18"
                                            Background="{ThemeResource AccentBrush}" Foreground="White"
                                            FontWeight="SemiBold" Padding="14,0" Click="AgentSendClick"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </PivotItem>

                <!-- Agent 集群 -->
                <PivotItem Header="Agent 集群">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="{ThemeResource PanelBrush}" Padding="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Agent 集群" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}"/>
                                <TextBlock x:Name="ClusterStatusText" Text="后端：待配置" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="ClusterBusyText" FontSize="12" Foreground="#07C160" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ToggleButton x:Name="ClusterFastToggle" Style="{ThemeResource LineIconToggle}" Click="ClusterFastToggleClick"
                                              ToolTipService.ToolTip="极速模式：短提示词 + 更小输出预算，集群响应更快">
                                    <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </ToggleButton>
                                <Button Style="{ThemeResource LineIconButton}" Click="ClusterTemplateMenuClick"
                                        ToolTipService.ToolTip="预设团队分工，一键让多个 Agent 并行干活">
                                    <FontIcon Glyph="&#xE716;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                                <Button x:Name="ClusterRegenerateBtn" Style="{ThemeResource LineIconButton}" Click="ClusterRegenerateClick"
                                        ToolTipService.ToolTip="删除上次集群结果并重新执行">
                                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                                <Button Style="{ThemeResource LineIconButton}" Click="ClusterClearClick"
                                        ToolTipService.ToolTip="清空当前集群会话">
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" x:Name="ClusterScroll" VerticalScrollBarVisibility="Auto"
                                      Padding="14,12" VerticalAlignment="Top"
                                      ViewChanged="ClusterScroll_ViewChanged">
                            <ItemsControl x:Name="ClusterList" ItemTemplate="{ThemeResource ChatMessageTemplate}"/>
                        </ScrollViewer>
                        <Button x:Name="ClusterScrollBottomBtn" Grid.Row="1"
                                Style="{ThemeResource LineIconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,12" Click="ClusterScrollBottomClick"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="滚动至最底部">
                            <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                        </Button>

                        <!-- 底部输入区：＋ / 🔍 / 发送按钮内嵌在输入框右下角 -->
                        <Grid Grid.Row="2" Background="{ThemeResource PanelBrush}" Padding="14,12">
                            <Grid>
                                <TextBox x:Name="ClusterInput"
                                         Style="{ThemeResource RoundTextBox}"
                                         Padding="14,10,180,10"
                                         PlaceholderText="一句话指挥：如「做一个待办事项网页」——自动拆成多个 Agent 并行干活…"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="140"
                                         FontSize="14" KeyDown="ClusterInputKeyDown" KeyUp="ClusterInputKeyUp"/>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,10,10">
                                    <Button x:Name="ClusterUploadBtn" Style="{ThemeResource LineIconButton}" Click="ClusterUploadClick"
                                            ToolTipService.ToolTip="上传文件给集群（图片/文档/代码等）">
                                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                    </Button>
                                    <ToggleButton x:Name="ClusterSearchToggle" Style="{ThemeResource LineIconToggle}" Click="ClusterSearchToggleClick"
                                                  ToolTipService.ToolTip="联网搜索开关（开=集群 Agent 可联网查资料）">
                                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"/>
                                    </ToggleButton>
                                    <Button x:Name="ClusterSendBtn" Content="发送" MinWidth="64" Height="36" CornerRadius="18"
                                            Background="{ThemeResource AccentBrush}" Foreground="White"
                                            FontWeight="SemiBold" Padding="14,0" Click="ClusterSendClick"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </PivotItem>

            </Pivot>
        </Grid>
    </Grid>
</Window>
