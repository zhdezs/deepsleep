<Project>

  <!-- 版本号只在这里改一处：外壳（TrollWrangler）、内核（Deepsleep.Core）、
       安装器（installer\DeepSleepSetup）三处共用，安装器通过 XmlPeek 读这里的 <Version>。
       以前各写各的，内核那份忘了同步导致程序自报版本一直是旧的（升到 2.1.0 还显示 2.0.0）；
       安装器又写死过 3.0.4，载荷已是 3.0.5 时注册表版本号还是错的。

       <Version>      对外版本号，功能有明显变化才进位（官网、安装包文件名都用它）。
       <FileVersion>  第 4 段是**内部构建号**：同一条版本线上每发一次就 +1。
                      OTA 靠它认出「版本号一样、其实是新包」的包 —— 只改构建号时
                      <Version> 不动，已经装在机器上的老客户端也能收到这次更新。
                      别手改：python tools/bump-build.py 会 +1 并同步代号。
       <DeepSleepCode> 这次构建的内部代号，随版本号一起显示与比对
                      （界面显示成 v3.2.3 · nebula.4）。换线时改名字，同线内不改。 -->
  <PropertyGroup>
    <Version>3.2.3</Version>
    <FileVersion>3.2.3.4</FileVersion>
    <DeepSleepCode>nebula</DeepSleepCode>
  </PropertyGroup>

  <!-- 编译进程序集元数据：非 Windows / 单文件发布时读不到 exe 的文件版本，
       内核从这里兜底读构建号和代号（Updater.CurrentBuild / CurrentCode）。 -->
  <ItemGroup>
    <AssemblyMetadata Include="DeepSleepBuild" Value="$(FileVersion)" />
    <AssemblyMetadata Include="DeepSleepCode" Value="$(DeepSleepCode)" />
  </ItemGroup>

</Project>
