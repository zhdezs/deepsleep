<Application
    x:Class="TrollWrangler.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrollWrangler">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 主题色（浅色 / 深色） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#B8F0F2F5"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#BFF7F8FA"/>
                    <SolidColorBrush x:Key="BubbleSelfBrush" Color="#C095EC69"/>
                    <SolidColorBrush x:Key="BubbleOtherBrush" Color="#D9FFFFFF"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A6"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#CCFFFFFF"/>
                    <SolidColorBrush x:Key="AttachBgBrush" Color="#CCEAF6EC"/>
                    <SolidColorBrush x:Key="SoftBgBrush" Color="#B8F5F5F5"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#66E4E7EB"/>
                    <SolidColorBrush x:Key="InputBgBrush" Color="#B8FFFFFF"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#66EFF2F5"/>
                    <SolidColorBrush x:Key="SelectedBrush" Color="#B8E6F5EA"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBrush" Color="#A816181C"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#B01E2024"/>
                    <SolidColorBrush x:Key="BubbleSelfBrush" Color="#B02E7D45"/>
                    <SolidColorBrush x:Key="BubbleOtherBrush" Color="#C02A2D33"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#8A9099"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#C026292F"/>
                    <SolidColorBrush x:Key="AttachBgBrush" Color="#B01E3A2A"/>
                    <SolidColorBrush x:Key="SoftBgBrush" Color="#B023262B"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#66353A42"/>
                    <SolidColorBrush x:Key="InputBgBrush" Color="#B023262B"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#66323840"/>
                    <SolidColorBrush x:Key="SelectedBrush" Color="#B01E3A2A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="AccentBrush" Color="#07C160"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#06AD56"/>

            <!-- 气泡样式 -->
            <Style x:Key="SelfBubble" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BubbleSelfBrush}"/>
                <Setter Property="CornerRadius" Value="12,3,12,12"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
            <Style x:Key="OtherBubble" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BubbleOtherBrush}"/>
                <Setter Property="CornerRadius" Value="3,12,12,12"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>

            <!-- 头像样式 -->
            <Style x:Key="Avatar" TargetType="Border">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="CornerRadius" Value="19"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Background" Value="#B0B0B0"/>
            </Style>
            <Style x:Key="AvatarSelf" TargetType="Border" BasedOn="{StaticResource Avatar}">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
            </Style>

            <!-- 圆角输入框 -->
            <Style x:Key="RoundTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource InputBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>

            <!-- 圆角幽灵按钮（工具栏通用） -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- 圆角幽灵开关（工具栏通用） -->
            <Style x:Key="GhostToggle" TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <!-- 简洁线条风圆形图标按钮 -->
            <Style x:Key="LineIconButton" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>
            <Style x:Key="LineIconToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <!-- 卡片 -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <local:InvertBoolConverter x:Key="InvertBool"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
