<Application
    x:Class="TrollWrangler.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrollWrangler">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- macOS 风格配色（浅色 / 深色两套） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#FFEDEDF0"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#C6F7F7F9"/>
                    <SolidColorBrush x:Key="BubbleSelfBrush" Color="#FF007AFF"/>
                    <SolidColorBrush x:Key="BubbleSelfTextBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="BubbleOtherBrush" Color="#FFE9E9EB"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#FF1D1D1F"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#FF86868B"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AttachBgBrush" Color="#FFEAF2FF"/>
                    <SolidColorBrush x:Key="SoftBgBrush" Color="#FFE6E6EA"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#26000000"/>
                    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="SelectedBrush" Color="#FFDCDCDE"/>
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBrush" Color="#FF1C1C1E"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#C62C2C2E"/>
                    <SolidColorBrush x:Key="BubbleSelfBrush" Color="#FF0A84FF"/>
                    <SolidColorBrush x:Key="BubbleSelfTextBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="BubbleOtherBrush" Color="#FF3A3A3C"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F7"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#FF98989D"/>
                    <SolidColorBrush x:Key="CardBrush" Color="#FF2C2C2E"/>
                    <SolidColorBrush x:Key="AttachBgBrush" Color="#FF1E3A5F"/>
                    <SolidColorBrush x:Key="SoftBgBrush" Color="#FF3A3A3C"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#26FFFFFF"/>
                    <SolidColorBrush x:Key="InputBgBrush" Color="#FF3A3A3C"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF"/>
                    <SolidColorBrush x:Key="SelectedBrush" Color="#FF48484C"/>
                    <SolidColorBrush x:Key="SeparatorBrush" Color="#26FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- macOS 系统蓝 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF007AFF"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF0062CC"/>

            <!-- 气泡样式（iMessage 风：大圆角 + 尖角） -->
            <Style x:Key="SelfBubble" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BubbleSelfBrush}"/>
                <Setter Property="CornerRadius" Value="18,5,18,18"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
            <Style x:Key="OtherBubble" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BubbleOtherBrush}"/>
                <Setter Property="CornerRadius" Value="5,18,18,18"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>

            <!-- 头像样式 -->
            <Style x:Key="Avatar" TargetType="Border">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="CornerRadius" Value="19"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Background" Value="#B0B0B0"/>
            </Style>
            <Style x:Key="AvatarSelf" TargetType="Border" BasedOn="{StaticResource Avatar}">
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
            </Style>

            <!-- 圆角输入框 -->
            <Style x:Key="RoundTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="{ThemeResource InputBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>

            <!-- 圆角幽灵按钮（工具栏通用） -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <!-- 圆角幽灵开关（工具栏通用） -->
            <Style x:Key="GhostToggle" TargetType="ToggleButton">
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <!-- 简洁线条风圆角图标按钮（macOS 工具栏按钮） -->
            <Style x:Key="LineIconButton" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style x:Key="LineIconToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- macOS 分段控件（Segmented Control）里的单个分段 -->
            <Style x:Key="SegmentButton" TargetType="Button">
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>

            <!-- 卡片 -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <local:InvertBoolConverter x:Key="InvertBool"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
