<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TrollWrangler</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>deepsleep</AssemblyName>
    <ApplicationIcon>deepsleep.ico</ApplicationIcon>
    <RootNamespace>TrollWrangler</RootNamespace>
    <ApplicationTitle>deepsleep · AI 助手</ApplicationTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内核是独立类库（src\Deepsleep.Core），别被外壳的默认通配符重复编译 -->
    <Compile Remove="Deepsleep.Core\**" />
    <Content Remove="Deepsleep.Core\**" />
    <None Remove="Deepsleep.Core\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Deepsleep.Core\Deepsleep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="deepsleep.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="pet.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="pet.raw" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ui\**" CopyToOutputDirectory="PreserveNewest" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="tools\set-github-token.ps1" CopyToOutputDirectory="PreserveNewest" Link="tools\set-github-token.ps1" />
    <Content Include="tools\publish-github-release.ps1" CopyToOutputDirectory="PreserveNewest" Link="tools\publish-github-release.ps1" />
    <Content Include="tools\websearch.py" CopyToOutputDirectory="PreserveNewest" Link="tools\websearch.py" />
  </ItemGroup>
  <!-- 瘦身：WindowsAppSDK 会带进 Windows ML / ONNX 推理运行时（本程序不使用），发布后剔除 -->
  <Target Name="TrimUnusedAiRuntime" AfterTargets="Publish">
    <ItemGroup>
      <TrimFiles Include="$(PublishDir)onnxruntime.dll" />
      <TrimFiles Include="$(PublishDir)DirectML.dll" />
      <TrimFiles Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
      <TrimFiles Include="$(PublishDir)NPUDetect.dll" />
      <TrimFiles Include="$(PublishDir)PerceptiveStreaming.dll" />
    </ItemGroup>
    <Delete Files="@(TrimFiles)" />
    <Message Importance="high" Text="已剔除未使用的 AI/ONNX 运行时（瘦身）" />
  </Target>
</Project>
