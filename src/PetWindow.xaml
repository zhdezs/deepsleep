<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrollWrangler.PetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="Bubble" Grid.Row="0" HorizontalAlignment="Center" CornerRadius="10"
                Background="#E6151A2B" Padding="10,5" Margin="4,0,4,4" Visibility="Collapsed">
            <TextBlock x:Name="BubbleText" Foreground="White" FontSize="12" TextWrapping="Wrap" MaxWidth="180"/>
        </Border>

        <Grid Grid.Row="1">
            <Ellipse Width="118" Height="118" Fill="#22FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Image x:Name="Whale" Width="104" Height="104" Stretch="Uniform"
                   Source="ms-appx:///pet.png"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.6"/>
            <ProgressRing x:Name="Busy" Width="118" Height="118" IsActive="False" Visibility="Collapsed"
                          Foreground="#7CA8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>