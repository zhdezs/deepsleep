<Project Sdk="Microsoft.NET.Sdk">

  <!-- deepsleep 内核：无任何界面依赖（不引用 WinUI），可被外壳 / 测试 / 命令行复用。
       多目标：net10.0-windows（Windows 外壳用，行为与改造前一致）+ net10.0（Linux / macOS）。
       平台相关代码都包在 #if WINDOWS 里，非 Windows 走 Platform.cs 的原生分支。 -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <RootNamespace>TrollWrangler</RootNamespace>
    <AssemblyName>Deepsleep.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1416：SetUnixFileMode 只跑在非 Windows 分支里，分析器看不出运行期判断 -->
    <NoWarn>$(NoWarn);CA1416;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
