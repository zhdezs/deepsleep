<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>deepsleep-Setup</AssemblyName>
    <ApplicationIcon>deepsleep.ico</ApplicationIcon>
    <AssemblyTitle>deepsleep AI 助手 安装程序</AssemblyTitle>
    <Product>deepsleep AI 助手</Product>
    <!-- 版本号统一由 ..\..\src\Directory.Build.props 提供（外壳/内核/安装器同一个源）。
         安装器不在 src\ 下面，MSBuild 不会自动 import 那份 Directory.Build.props，
         所以这里**显式 Import**。
         ⚠ 别再改回 XmlPeek + Target 那种写法：属性求值发生在所有 Target 之前，
         `<Version>$(DeepSleepVersion)</Version>` 早就按空值算成 1.0.0.0 了 ——
         结果安装器界面和注册表 DisplayVersion 一直显示 1.0.0（踩过）。 -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\src\Directory.Build.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\Directory.Build.props')" />

  <!-- 必须在 Import 之后求值，否则 $(Version) 还是空的 -->
  <PropertyGroup Condition="'$(Version)' == ''">
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\payload.zip">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(Version)' != ''">
    <AssemblyMetadata Include="DeepSleepVersion" Value="$(Version)" />
  </ItemGroup>
</Project>
