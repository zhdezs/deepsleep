<Window x:Class="DeepSleepSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="deepsleep AI 助手 安装程序" Height="470" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F6F7F9">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题条 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,20,28,18">
            <StackPanel>
                <TextBlock Text="deepsleep AI 助手" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="SubTitle" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                           Text="版本 2.1.1  ·  内核与界面分离（界面改用 HTML + WebView2 渲染 / 工具调用链 / 技能 / Agent 集群 / 长期记忆 / 更新强制走 Gitee 秒更）"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,22,28,0">
            <TextBlock Text="安装位置" Foreground="{StaticResource TextBrush}"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0"/>
                <Button x:Name="BrowseBtn" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Width="86" Click="Browse_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <CheckBox x:Name="DesktopChk" Content="创建桌面快捷方式" IsChecked="True" Width="200"/>
                <CheckBox x:Name="LaunchChk" Content="安装完成后立即启动" IsChecked="True"/>
            </StackPanel>

            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,18,0,0">
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                           Text="程序包会自解压到上面选择的位置，不需要管理员权限。用户数据（API Key、对话历史、长期记忆、自训练模型）保存在安装目录的 data 文件夹内，升级安装不会覆盖已有的 Key 与记录。每台电脑需要单独在 ⚙ 设置里填写自己的 API Key，或启用本地 Ollama。装好之后把「更新源」填成 GitHub 仓库（owner/repo），以后新版本会在软件里一键静默升级（Gitee 优先，自动回退 GitHub）。"/>
            </Border>

            <ProgressBar x:Name="Bar" Height="14" Margin="0,22,0,0" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" Text="准备就绪"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InstallBtn" Content="开始安装" Width="120" Height="36"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Click="Install_Click"/>
                <Button x:Name="CancelBtn" Content="退出" Width="96" Height="36" Margin="10,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
